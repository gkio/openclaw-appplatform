#!/command/with-contenv bash
# Wire channel tokens + OAuth credentials from env into openclaw state.
# Runs after 20-setup-openclaw (config exists) and before openclaw service starts.
# MUST NOT fail the container: every branch tolerates missing/invalid input.
source /etc/s6-overlay/lib/env-utils.sh

source_env_prefix OPENCLAW_ || true
source_env_prefix TELEGRAM_ || true
source_env_prefix CODEX_ || true
source_env_prefix GITHUB_ || true
source_env_prefix GH_ || true
source_env_prefix TAVILY_ || true
source_env_prefix XAI_ || true
source_env_prefix BRAVE_ || true
source_env_prefix EXA_ || true

# Forward specific API-key envs into OPENCLAW_ dir so the openclaw service
# (runs with with_env_prefix OPENCLAW_) can see them.
forward_to_openclaw() {
  local v
  for v in GITHUB_TOKEN GH_TOKEN TAVILY_API_KEY XAI_API_KEY BRAVE_API_KEY EXA_API_KEY; do
    if [ -n "${!v}" ]; then
      echo "${!v}" > "/run/s6/container_environment/OPENCLAW_/$v"
      chmod 600 "/run/s6/container_environment/OPENCLAW_/$v" 2>/dev/null || true
      echo "[wire-extras] forwarded $v to openclaw env"
    fi
  done
}
forward_to_openclaw

CONFIG_FILE="${OPENCLAW_STATE_DIR:-/data/.openclaw}/openclaw.json"
OC_HOME="/home/openclaw"

inject_telegram_token() {
  if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
    echo "[wire-extras] TELEGRAM_BOT_TOKEN not set, skipping"
    return 0
  fi
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "[wire-extras] config missing at $CONFIG_FILE, skipping telegram"
    return 0
  fi

  echo "[wire-extras] Injecting channels.telegram.botToken"
  if jq --arg t "$TELEGRAM_BOT_TOKEN" \
    '.channels.telegram.enabled = true
     | .channels.telegram.botToken = $t' \
    "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null; then
    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    chown openclaw:openclaw "$CONFIG_FILE" || true
    echo "[wire-extras] telegram token injected"
  else
    echo "[wire-extras] ERROR: jq failed on config; skipping telegram"
    rm -f "${CONFIG_FILE}.tmp"
  fi
}

install_codex_auth() {
  if [ -z "$CODEX_AUTH_B64" ]; then
    echo "[wire-extras] CODEX_AUTH_B64 not set, skipping codex auth"
    return 0
  fi

  echo "[wire-extras] Installing codex auth.json (b64 size=${#CODEX_AUTH_B64})"
  install -d -m 0700 -o openclaw -g openclaw "$OC_HOME/.codex" 2>/dev/null || mkdir -p "$OC_HOME/.codex"

  local tmp="$OC_HOME/.codex/auth.json.tmp"
  # Strip whitespace, tolerate wrapping/corruption
  local stripped
  stripped=$(printf '%s' "$CODEX_AUTH_B64" | tr -d '[:space:]')
  if printf '%s' "$stripped" | base64 -d > "$tmp" 2>/dev/null; then
    :
  elif printf '%s' "$stripped" | base64 --decode > "$tmp" 2>/dev/null; then
    :
  else
    echo "[wire-extras] WARNING: base64 decode failed; skipping codex auth"
    rm -f "$tmp"
    return 0
  fi

  if ! jq -e '.tokens.access_token' "$tmp" >/dev/null 2>&1; then
    echo "[wire-extras] WARNING: decoded codex auth has no access_token; skipping"
    rm -f "$tmp"
    return 0
  fi

  mv "$tmp" "$OC_HOME/.codex/auth.json"
  chown openclaw:openclaw "$OC_HOME/.codex/auth.json" 2>/dev/null || true
  chmod 0600 "$OC_HOME/.codex/auth.json"
  echo "[wire-extras] codex auth.json installed"
}

inject_telegram_token
install_codex_auth

echo "[wire-extras] Done"
exit 0
